# --- Build artifacts (CMake + CUDA) ------------------------------------------
# Out-of-source builds are the norm (build-ci/, build-release/, ...); the
# trailing entries catch accidental in-source configuration.
build*/
cmake-build-*/
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
install/
*.o
*.a
*.so

# --- Generated runtime outputs -------------------------------------------------
# shardspec.json / checkpoint_inventory.json are derived from the local HF
# cache; regenerate with tools/make_shardspec.py or tools/checkpoint_audit.py.
artifacts/

# --- Python tooling -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
/data/
venv/

# --- Editor / IDE / OS detritus -------------------------------------------------
.vscode/
.idea/
.clangd/
.cache/
*.swp
*~
.DS_Store

# --- Debug residue ---------------------------------------------------------------
/core
core.*

# Fabric-run artifacts (rank 0 writes its token transcript to its CWD)
glm_gen.tokens.txt
# glm_serve writes rank 0's op stream beside the binary; serve_run.sh moves it into the run log
/serve_rank*.ops
dist/
# The TP tests write this fixture into their working directory; never track a copy
glm_tp_fixture/
glm_tp_fixture_fp4/
qwen_engine_fixture/
qwen_loader_fixture/
glm_dsa_loader_fixture/
glm_dsa_engine_fixture/
glm_dsa_engine_fixture_wide_*/
glm_dsa_forward_fixture/
# Local deployment copies hold model choices and engine tuning. Shared node
# addresses, SSH login, ports and site paths live in .env, not these JSONs.
# Keep legacy filenames ignored as well while existing sites migrate.
deploy/cluster.json
deploy/cluster.*.json
deploy/cluster_*.json
!deploy/*.example.json
.env
.env.*
!.env.example

# Site operations that never belong in the tree: the node memory-reclaim
# script stops and runtime-masks services and needs root on every node. It is
# kept outside the repository; this entry is here so a copy dropped back into
# scripts/ is not committed by accident.
scripts/maximize-cluster-memory.sh
.pi/
