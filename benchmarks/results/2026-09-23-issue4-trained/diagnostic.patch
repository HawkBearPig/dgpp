--- a/src/kernels/qwen_moe.cu
+++ b/src/kernels/qwen_moe.cu
@@ -7,10 +7,30 @@
 #include "kernels/bf16_gemv.cuh"
 #include "kernels/fp8_gemv.cuh"
 #include "kernels/gemv_common.cuh"
+#include "kernels/latent_format.hpp"
 
 namespace dgpp {
 namespace {
 
+__global__ void issue4_quant_kernel(const uint16_t* input, uint16_t* output,
+                                     int groups, float global) {
+  const int g = blockIdx.x * blockDim.x + threadIdx.x;
+  if (g >= groups) return;
+  float x[16], amax = 0.f;
+  for (int j = 0; j < 16; ++j) {
+    x[j] = bf16_bits_to_float(input[g * 16 + j]);
+    amax = fmaxf(amax, fabsf(x[j]));
+  }
+  const float scale = fp8_e4m3_bits_to_float(float_to_fp8_e4m3_bits(
+      fminf(448.f, global * (amax * (1.f / 6.f)))));
+  const float encode = scale == 0.f ? 0.f : global / scale;
+  const float decode = scale / global;
+  for (int j = 0; j < 16; ++j) {
+    const float y = fp4_e2m1_bits_to_float(float_to_fp4_e2m1_bits(x[j] * encode));
+    output[g * 16 + j] = float_to_bf16_bits(y * decode);
+  }
+}
+
 __device__ __forceinline__ float round_bf16(float v) {
   return bf16_bits_to_float(float_to_bf16_bits(v));
 }
@@ -245,4 +265,13 @@ void qwen_moe_shared_tail_decode_fp8(const uint16_t* x, size_t x_stride, const u
   tail_rows<true>(x, x_stride, gate_p, gate_s, up_p, up_s, down_p, down_s, g, act, sw, acc, out, tokens, H, S, stream);
 }
 
+void issue4_nvfp4_activations(const uint16_t* input, uint16_t* output,
+                              int rows, int width, float global, cudaStream_t stream) {
+  if (rows <= 0 || width <= 0 || width % 16 || !(global > 0.f))
+    throw std::invalid_argument("issue4 activation shape/scale");
+  const int groups = rows * (width / 16);
+  issue4_quant_kernel<<<(groups + 127) / 128, 128, 0, stream>>>(input, output, groups, global);
+  DGPP_CUDA_OK(cudaGetLastError());
+}
+
 }  // namespace dgpp
