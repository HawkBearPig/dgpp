+// Single-sequence GDN prefill in 64-token blocks. Q/K normalization and
+// block-matrix intermediates use BF16; the persistent state remains FP32.
+// This initial implementation supports the Qwen 128 x 128 head geometry.
+size_t gdn_chunk_workspace_bytes(int tokens, int key_heads, int value_heads);
+
+void gdn_chunk_fwd(const uint16_t* qkv, const uint16_t* a, int64_t a_stride,
