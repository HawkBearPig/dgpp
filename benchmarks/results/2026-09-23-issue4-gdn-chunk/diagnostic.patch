+DeviceRun run_chunk_device(const Problem& p, const std::vector<float>& initial, int span) {
+  cudaStream_t stream = test_stream();
+  DevBuf x(p.qkv.size() * 2), a(p.a_raw.size() * 2), beta(p.beta_raw.size() * 2);
+  DevBuf al(p.a_log.size() * 4), dt(p.dt_bias.size() * 4), st(initial.size() * 4);
+  DevBuf out(static_cast<size_t>(p.tokens) * p.heads * p.v * 2);
+  const size_t bytes = dgpp::gdn_chunk_workspace_bytes(span, p.heads_k(), p.heads);
+  DevBuf workspace(bytes);
+  x.upload(p.qkv.data(), p.qkv.size() * 2);
+  a.upload(p.a_raw.data(), p.a_raw.size() * 2);
+  beta.upload(p.beta_raw.data(), p.beta_raw.size() * 2);
+  al.upload(p.a_log.data(), p.a_log.size() * 4);
+  dt.upload(p.dt_bias.data(), p.dt_bias.size() * 4);
+  st.upload(initial.data(), initial.size() * 4);
+  for (int first = 0; first < p.tokens; first += span) {
+    const int count = std::min(span, p.tokens - first);
+    dgpp::gdn_chunk_fwd(x.as<uint16_t>() + first * p.qkv_row(),
+                        a.as<uint16_t>() + first * p.heads, p.heads,
+                        beta.as<uint16_t>() + first * p.heads, p.heads,
+                        al.as<float>(), dt.as<float>(), st.as<float>(),
+                        out.as<uint16_t>() + static_cast<int64_t>(first) * p.heads * p.v,
+                        count, p.heads_k(), p.heads, p.scale,
+                        workspace.as<uint8_t>(), bytes, stream);
+  }
+  DGPP_CUDA_OK(cudaStreamSynchronize(stream));
+  DeviceRun result;
+  result.out.resize(static_cast<size_t>(p.tokens) * p.heads * p.v);
+  result.state.resize(initial.size());
+  out.download(result.out.data(), result.out.size() * 2);
+  st.download(result.state.data(), result.state.size() * 4);
+  return result;
+}
+
 }  // namespace
 
+DGPP_TEST(gdn_block_prefill_preserves_state_across_aligned_calls) {
+  // Distinct grouped heads, nonzero incoming state and a partial final block.
+  // Moving complete blocks between calls must not change their arithmetic.
+  const Problem p = Problem::make(193, 711, 6, 3);
+  const auto initial = random_state(p, 23);
+  const auto whole = run_chunk_device(p, initial, p.tokens);
+  for (int span : {64, 128, 193}) {
+    const auto split = run_chunk_device(p, initial, span);
+    require_bitwise("block prefill outputs", whole.out.data(), split.out.data(), whole.out.size() * 2);
+    require_bitwise("block prefill state", whole.state.data(), split.state.data(), whole.state.size() * 4);
+  }
+}
