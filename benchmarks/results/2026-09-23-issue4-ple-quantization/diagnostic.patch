+DGPP_TEST(qwen_loader_bf16_ngram_mmap_preserves_bits_and_rank_bounds) {
+  const fs::path dir = fs::current_path() / "qwen_bf16_ngram_mmap_fixture";
+  fs::create_directories(dir);
+  struct Cleanup { fs::path dir; ~Cleanup() { fs::remove_all(dir); } } cleanup{dir};
+  constexpr int capacity = 7, hd = 3, total_rows = 17;
+  std::vector<uint16_t> expected(total_rows * hd);
+  for (size_t i = 0; i < expected.size(); ++i) expected[i] = static_cast<uint16_t>(0x3f00 + i);
+  std::vector<dgpp::QwenNgramTableMmap::Part> parts;
+  for (int shard = 0; shard < 3; ++shard) {
+    const int first = shard * capacity, rows = std::min(capacity, total_rows - first);
+    const fs::path path = dir / ("shard" + std::to_string(shard));
+    if (shard != 0) {
+      std::ofstream file(path, std::ios::binary);
+      file.write("start", 5);
+      file.write(reinterpret_cast<const char*>(expected.data() + first * hd), rows * hd * 2);
+    }
+    parts.push_back({path.string(), 5, rows});
+  }
+  // The first shard is deliberately absent: this rank never reads its rows.
+  dgpp::QwenNgramTableMmap table(parts, capacity, hd, 2, 8, 9);
+  require(table.element_bytes() == 2, "BF16 element width");
+  for (int row : {8, 13, 14, 16})
+    require(std::memcmp(table.row(row), expected.data() + row * hd, hd * 2) == 0, "BF16 row bits");
+  for (int row : {-1, 0, 7, 17}) {
+    bool rejected = false;
+    try { (void)table.row(row); } catch (const std::out_of_range&) { rejected = true; }
+    require(rejected, "row outside this rank rejected");
+  }
+  for (int n : {3, 512}) {
+    std::vector<int32_t> ids(n * 4, 0);
+    for (int t = 0; t < n; ++t)
+      for (int h = 1; h < 3; ++h) ids[t * 4 + h] = 8 + (t * 2 + h) % 9;
+    std::vector<uint8_t> got(static_cast<size_t>(n) * 2 * hd * 2);
+    table.gather(ids.data(), n, 4, 1, 2, got.data());
+    for (int t = 0; t < n; ++t)
+      for (int h = 0; h < 2; ++h)
+        require(std::memcmp(got.data() + (t * 2 + h) * hd * 2,
+                            expected.data() + ids[t * 4 + 1 + h] * hd, hd * 2) == 0,
+                "serial/parallel BF16 gather bits and head selection");
+  }
+}
