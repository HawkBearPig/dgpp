+    return dgpp::bf16_bits_to_float(dgpp::float_to_bf16_bits(static_cast<float>(v)));
+  };
+  std::vector<uint16_t> expected(rows * heads * g.dim);
+  for (int r = 0; r < rows; ++r)
+    for (int h = 0; h < heads; ++h)
+      for (int d = 0; d < g.dim; ++d) {
+        const auto normalized = [&](int i) {
+          return static_cast<double>(dgpp::bf16_bits_to_float(x[r*stride+h*2*g.dim+i])) *
+                 (1.0 + dgpp::bf16_bits_to_float(w[i]));
+        };
+        double result = normalized(d);
+        if (d < g.rotary) {
+          const int half = g.rotary/2, k = d % half;
+          const float angle = static_cast<float>(positions[r]) * inv[k];
+          const double c = bf(std::cos(angle)), s = bf(std::sin(angle));
+          const double other = normalized(d < half ? d+half : d-half);
+          result = result*c + (d < half ? -other : other)*s;
+        }
+        expected[(r*heads+h)*g.dim+d] = dgpp::float_to_bf16_bits(static_cast<float>(result));
+      }
+  DevBuf dx=up(x), dw=up(w), dp=up(positions), di=up(inv), dout(expected.size()*2);
+  const auto st = test_stream();
+  int differences = 0;
+  for (bool fp32 : {false, true}) {
+    dgpp::qsa_norm_rope_bf16(ptr<uint16_t>(dx), stride, 2*g.dim, ptr<uint16_t>(dw),
+        ptr<int64_t>(dp), ptr<float>(di), mptr<uint16_t>(dout), heads*g.dim,
+        rows, heads, g.dim, g.rotary, 0.f, 1.f, st, fp32);
+    DGPP_CUDA_OK(cudaStreamSynchronize(st));
+    const auto got=down<uint16_t>(dout,expected.size());
+    if (fp32) require(got == expected, "FP32 rotation differs from independent FP64 storage oracle");
+    else for (size_t i=0; i<got.size(); ++i) differences += got[i] != expected[i];
+  }
+  require(differences > rows*heads*g.rotary/10, "fixture does not distinguish old rotation products");
+  std::printf("[ .. ] FP32 main RoPE: all %zu exact; old policy differs at %d values\n",
+              expected.size(),differences);
+}
