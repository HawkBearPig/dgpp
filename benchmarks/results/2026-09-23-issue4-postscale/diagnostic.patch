     float uv = round_bf16(ua[r]);  // the up GEMV's
     if (gv > limit) gv = limit;
     uv = fminf(fmaxf(uv, -limit), limit);
-    const uint16_t t = float_to_bf16_bits(gv * (1.0f / (1.0f + expf(-gv))));  // rounding 1
     act[static_cast<size_t>(r) * S + row] =
-        float_to_bf16_bits(bf16_bits_to_float(t) * uv);  // rounding 2
+        float_to_bf16_bits((gv * (1.0f / (1.0f + expf(-gv)))) * uv);
   }
 }
 
@@ -245,4 +264,13 @@ void qwen_moe_shared_tail_decode_fp8(const uint16_t* x, size_t x_stride, const u
   tail_rows<true>(x, x_stride, gate_p, gate_s, up_p, up_s, down_p, down_s, g, act, sw, acc, out, tokens, H, S, stream);
 }
 
+void issue4_nvfp4_activations(const uint16_t* input, uint16_t* output,
+                              int rows, int width, float global, cudaStream_t stream) {
+  if (rows <= 0 || width <= 0 || width % 16 || !(global > 0.f))
+    throw std::invalid_argument("issue4 activation shape/scale");
+  const int groups = rows * (width / 16);
+  issue4_quant_kernel<<<(groups + 127) / 128, 128, 0, stream>>>(input, output, groups, global);
+  DGPP_CUDA_OK(cudaGetLastError());
+}
+
 }  // namespace dgpp
