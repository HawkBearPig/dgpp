@@ -7,10 +7,30 @@
 #include "kernels/bf16_gemv.cuh"
 #include "kernels/fp8_gemv.cuh"
 #include "kernels/gemv_common.cuh"
+#include "kernels/latent_format.hpp"
 
 namespace dgpp {
 namespace {
 
+__global__ void issue4_quant_kernel(const uint16_t* input, uint16_t* output,
+                                     int groups, float global) {
+  const int g = blockIdx.x * blockDim.x + threadIdx.x;
+  if (g >= groups) return;
+  float x[16], amax = 0.f;
+  for (int j = 0; j < 16; ++j) {
+    x[j] = bf16_bits_to_float(input[g * 16 + j]);
+    amax = fmaxf(amax, fabsf(x[j]));
+  }
+  const float scale = fp8_e4m3_bits_to_float(float_to_fp8_e4m3_bits(
+      fminf(448.f, global * (amax * (1.f / 6.f)))));
+  const float encode = scale == 0.f ? 0.f : global / scale;
+  const float decode = scale;  // diagnostic: global applied after the dot
+  for (int j = 0; j < 16; ++j) {
+    const float y = fp4_e2m1_bits_to_float(float_to_fp4_e2m1_bits(x[j] * encode));
+    output[g * 16 + j] = float_to_bf16_bits(y * decode);
+  }
+}
+
 __device__ __forceinline__ float round_bf16(float v) {
   return bf16_bits_to_float(float_to_bf16_bits(v));
 }
