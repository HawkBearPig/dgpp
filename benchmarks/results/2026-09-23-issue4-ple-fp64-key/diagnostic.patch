diff --git a/src/kernels/qwen_ple_fp64.cu b/src/kernels/qwen_ple_fp64.cu
new file mode 100644
index 0000000..a551344
--- /dev/null
+++ b/src/kernels/qwen_ple_fp64.cu
@@ -0,0 +1,74 @@
+#include "kernels/qwen_ple_fp64.hpp"
+
+#include <cublas_v2.h>
+#include <cuda_bf16.h>
+#include <stdexcept>
+#include "common/cuda_check.hpp"
+
+namespace dgpp {
+namespace {
+__global__ void widen(const __nv_bfloat16* in, double* out, size_t count) {
+  for (size_t i = size_t(blockIdx.x) * blockDim.x + threadIdx.x; i < count;
+       i += size_t(gridDim.x) * blockDim.x)
+    out[i] = static_cast<double>(__bfloat162float(in[i]));
+}
+
+__global__ void narrow(const double* in, __nv_bfloat16* out, size_t count) {
+  for (size_t i = size_t(blockIdx.x) * blockDim.x + threadIdx.x; i < count;
+       i += size_t(gridDim.x) * blockDim.x)
+    out[i] = __float2bfloat16_rn(__double2float_rn(in[i]));
+}
+}  // namespace
+
+struct QwenPleFp64Key::Impl {
+  int max_rows, n, k;
+  cublasHandle_t handle = nullptr;
+  double *act = nullptr, *weight = nullptr, *out = nullptr;
+  Impl(int rows, int outputs, int inputs) : max_rows(rows), n(outputs), k(inputs) {}
+  ~Impl() {
+    if (handle) cublasDestroy(handle);
+    cudaFree(act);
+    cudaFree(weight);
+    cudaFree(out);
+  }
+};
+
+QwenPleFp64Key::QwenPleFp64Key(int max_rows, int output_width, int input_width)
+    : impl_(std::make_unique<Impl>(max_rows, output_width, input_width)) {
+  if (max_rows <= 0 || output_width <= 0 || input_width <= 0)
+    throw std::invalid_argument("PLE FP64: dimensions must be positive");
+  auto& p = *impl_;
+  DGPP_CUBLAS_OK(cublasCreate(&p.handle), "PLE FP64 create");
+  DGPP_CUDA_OK(cudaMalloc(&p.act, size_t(max_rows) * p.k * sizeof(double)));
+  DGPP_CUDA_OK(cudaMalloc(&p.weight, size_t(p.n) * p.k * sizeof(double)));
+  DGPP_CUDA_OK(cudaMalloc(&p.out, size_t(max_rows) * p.n * sizeof(double)));
+}
+
+QwenPleFp64Key::~QwenPleFp64Key() = default;
+
+size_t QwenPleFp64Key::scratch_bytes(int max_rows, int output_width, int input_width) {
+  return (size_t(max_rows) * input_width + size_t(output_width) * input_width +
+          size_t(max_rows) * output_width) * sizeof(double);
+}
+
+void QwenPleFp64Key::project(const uint16_t* act, const uint16_t* weight, uint16_t* out,
+                            int rows, void* workspace, size_t workspace_bytes, cudaStream_t stream) {
+  auto& p = *impl_;
+  if (rows <= 0 || rows > p.max_rows || !act || !weight || !out || !workspace)
+    throw std::invalid_argument("PLE FP64: invalid operands or row count");
+  // SetStream resets cuBLAS workspace, so bind the caller's scratch afterwards.
+  DGPP_CUBLAS_OK(cublasSetStream(p.handle, stream), "PLE FP64 stream");
+  DGPP_CUBLAS_OK(cublasSetWorkspace(p.handle, workspace, workspace_bytes), "PLE FP64 workspace");
+  widen<<<1024, 256, 0, stream>>>(reinterpret_cast<const __nv_bfloat16*>(act), p.act, size_t(rows) * p.k);
+  // Reconvert each call so a streamed/rebound weight cannot leave a stale cache.
+  widen<<<1024, 256, 0, stream>>>(reinterpret_cast<const __nv_bfloat16*>(weight), p.weight, size_t(p.n) * p.k);
+  DGPP_CUDA_OK(cudaGetLastError());
+  const double alpha = 1.0, beta = 0.0;
+  DGPP_CUBLAS_OK(cublasDgemm(p.handle, CUBLAS_OP_T, CUBLAS_OP_N, p.n, rows, p.k,
+                            &alpha, p.weight, p.k, p.act, p.k, &beta, p.out, p.n), "PLE FP64 product");
+  // Explicit FP32 then BF16 round-to-nearest matches the independent oracle.
+  narrow<<<1024, 256, 0, stream>>>(p.out, reinterpret_cast<__nv_bfloat16*>(out), size_t(rows) * p.n);
+  DGPP_CUDA_OK(cudaGetLastError());
+}
+
+}  // namespace dgpp
diff --git a/src/kernels/qwen_ple_fp64.hpp b/src/kernels/qwen_ple_fp64.hpp
new file mode 100644
index 0000000..28ff619
--- /dev/null
+++ b/src/kernels/qwen_ple_fp64.hpp
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <cuda_runtime.h>
+
+namespace dgpp {
+
+// Issue #4 diagnostic, not a production lowering: retain BF16 operands and
+// rank-partial boundaries while isolating accumulation in the PLE key product.
+class QwenPleFp64Key {
+ public:
+  QwenPleFp64Key(int max_rows, int output_width, int input_width);
+  ~QwenPleFp64Key();
+  QwenPleFp64Key(const QwenPleFp64Key&) = delete;
+  QwenPleFp64Key& operator=(const QwenPleFp64Key&) = delete;
+  static size_t scratch_bytes(int max_rows, int output_width, int input_width);
+  void project(const uint16_t* act, const uint16_t* weight, uint16_t* out,
+               int rows, void* workspace, size_t workspace_bytes, cudaStream_t stream);
+
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace dgpp
