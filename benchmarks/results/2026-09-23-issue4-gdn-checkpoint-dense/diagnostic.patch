+DGPP_TEST(gdn_block_prefill_preserves_state_across_aligned_calls) {
+  // Distinct grouped heads, nonzero incoming state and a partial final block.
+  // Moving complete blocks between calls must not change their arithmetic.
+  const Problem p = Problem::make(193, 711, 6, 3);
+  const auto initial = random_state(p, 23);
+  const auto whole = run_chunk_device(p, initial, p.tokens);
+  for (int span : {64, 128, 193}) {
+    const auto split = run_chunk_device(p, initial, span);
+    require_bitwise("block prefill outputs", whole.out.data(), split.out.data(), whole.out.size() * 2);
+    require_bitwise("block prefill state", whole.state.data(), split.state.data(), whole.state.size() * 4);
+  }
+}
