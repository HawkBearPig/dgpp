+DGPP_TEST(gdn_block_prefill_matches_the_pinned_reference) {
+  // Dyadic inputs are reproducible without a random generator or libm.
+  // The independently generated fixture spans two blocks and a one-token tail.
+  Problem p;
+  p.tokens = 129; p.heads = 6; p.kv_ratio = 3; p.scale = ref_scale(128);
+  p.qkv.resize(static_cast<size_t>(p.tokens) * p.qkv_row());
+  p.a_raw.resize(p.tokens * p.heads); p.beta_raw.resize(p.tokens * p.heads);
+  p.a_log.resize(p.heads); p.dt_bias.resize(p.heads);
+  std::vector<float> initial(p.state_elems());
+  for (int h = 0; h < p.heads; ++h) {
+    p.a_log[h] = -3.f + h / 8.f; p.dt_bias[h] = -2.5f + h / 16.f;
+    for (int v = 0; v < 128; ++v)
+      for (int d = 0; d < 128; ++d)
+        initial[(h * 128 + v) * 128 + d] = ((h * 3 + d * 5) % 17 - 8) / 32.f;
+  }
+  for (int t = 0; t < p.tokens; ++t) {
+    auto* x = p.qkv.data() + t * p.qkv_row();
+    for (int h = 0; h < 2; ++h)
+      for (int d = 0; d < 128; ++d) {
+        x[h * 128 + d] = dgpp::float_to_bf16_bits(((t * 7 + h * 11 + d * 3) % 31 - 15) / 16.f);
+        x[(2 + h) * 128 + d] = dgpp::float_to_bf16_bits(((t * 5 + h * 13 + d * 7) % 29 - 14) / 16.f);
+      }
+    for (int h = 0; h < p.heads; ++h) {
+      p.a_raw[t * p.heads + h] = dgpp::float_to_bf16_bits(-3.f + ((t + 2 * h) % 13 - 6) / 8.f);
+      p.beta_raw[t * p.heads + h] = dgpp::float_to_bf16_bits(((t * 2 + h) % 9 - 4) / 4.f);
+      for (int d = 0; d < 128; ++d)
+        x[(4 + h) * 128 + d] = dgpp::float_to_bf16_bits(((t * 3 + h * 5) % 23 - 11) / 8.f);
+    }
+  }
+  const auto got = run_chunk_device(p, initial, p.tokens);
+  double error = 0., norm = 0.;
+  for (size_t i = 0; i < got.out.size(); ++i) {
+    const double expected = bf16_bits_to_float(dgpp::gdn_chunk_fixture::output[i / 128]);
+    const double actual = bf16_bits_to_float(got.out[i]);
+    if (!std::isfinite(actual)) throw std::runtime_error("nonfinite block GDN output");
+    error += (actual - expected) * (actual - expected); norm += expected * expected;
+  }
+  if (std::sqrt(error / norm) >= .0005) throw std::runtime_error("block GDN output differs from reference");
+  error = norm = 0.;
+  for (size_t i = 0; i < got.state.size(); ++i) {
+    const size_t h = i / (128 * 128), d = i % 128;
+    const double expected = std::bit_cast<float>(dgpp::gdn_chunk_fixture::state_bits[h * 128 + d]);
+    const double actual = got.state[i];
+    if (!std::isfinite(actual)) throw std::runtime_error("nonfinite block GDN state");
+    error += (actual - expected) * (actual - expected); norm += expected * expected;
+  }
+  if (std::sqrt(error / norm) >= .0001) throw std::runtime_error("block GDN state differs from reference");
+}
