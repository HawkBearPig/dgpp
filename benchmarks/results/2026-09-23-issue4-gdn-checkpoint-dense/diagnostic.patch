@@ -0,0 +1,263 @@
+#include "kernels/gdn_chunk.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+
+#include "common/cuda_check.hpp"
+#include "common/dtypes.hpp"
+
+namespace dgpp {
+namespace {
+constexpr int B = 64;
+constexpr int D = 128;
+constexpr int VS = 32;
+
+__device__ float f(uint16_t x) { return bf16_bits_to_float(x); }
+__device__ uint16_t b(float x) { return float_to_bf16_bits(x); }
+__device__ float ex(float x) { return __expf(x); }
+
+struct Buffers {
+  uint16_t *q, *k, *inverse, *w, *u, *vn, *h;
+  float *g, *beta;
+};
+
+Buffers buffers(void* memory, int chunks, int hk, int hv) {
+  auto* p = static_cast<uint16_t*>(memory);
+  Buffers s;
+  const size_t nk = size_t(chunks) * hk * B * D;
+  const size_t nv = size_t(chunks) * hv * B * D;
+  s.q = p; p += nk;
+  s.k = p; p += nk;
+  s.inverse = p; p += size_t(chunks) * hv * B * B;
+  s.w = p; p += nv;
+  s.u = p; p += nv;
+  s.vn = p; p += nv;
+  s.h = p; p += size_t(chunks) * hv * D * D;
+  s.g = reinterpret_cast<float*>(p);
+  s.beta = s.g + size_t(chunks) * hv * B;
+  return s;
+}
+
+__global__ void prepare_qk(const uint16_t* x, uint16_t* q, uint16_t* k,
+                           int tokens, int hk, int hv) {
+  const int t = blockIdx.x, h = blockIdx.y, d = threadIdx.x;
+  const int64_t src = int64_t(t) * (2 * hk + hv) * D + h * D + d;
+  float qv = t < tokens ? f(x[src]) : 0.f;
+  float kv = t < tokens ? f(x[src + hk * D]) : 0.f;
+  __shared__ float qs[D], ks[D];
+  qs[d] = qv * qv; ks[d] = kv * kv;
+  __syncthreads();
+  for (int step = D / 2; step; step /= 2) {
+    if (d < step) { qs[d] += qs[d + step]; ks[d] += ks[d + step]; }
+    __syncthreads();
+  }
+  const int64_t dst = ((int64_t(t / B) * hk + h) * B + t % B) * D + d;
+  q[dst] = b(qv * (1.f / sqrtf(qs[0] + 1e-6f)));
+  k[dst] = b(kv * (1.f / sqrtf(ks[0] + 1e-6f)));
+}
+
+__global__ void prepare_gates(const uint16_t* a, int64_t as,
+                              const uint16_t* raw_beta, int64_t bs,
+                              const float* al, const float* dt,
+                              float* g, float* beta, int tokens, int hv) {
+  const int c = blockIdx.x, h = blockIdx.y, i = threadIdx.x;
+  const int t = c * B + i;
+  __shared__ float scan[B];
+  float gv = 0.f, bv = 0.f;
+  if (t < tokens) {
+    const float x = f(a[int64_t(t) * as + h]) + dt[h];
+    const float sp = x > 20.f ? x : fmaxf(x, 0.f) + __logf(1.f + ex(-fabsf(x)));
+    gv = -ex(al[h]) * sp;
+    bv = 1.f / (1.f + ex(-f(raw_beta[int64_t(t) * bs + h])));
+  }
+  scan[i] = gv;
+  __syncthreads();
+  for (int step = 1; step < B; step *= 2) {
+    const float prev = i >= step ? scan[i - step] : 0.f;
+    __syncthreads();
+    scan[i] += prev;
+    __syncthreads();
+  }
+  const int64_t dst = (int64_t(c) * hv + h) * B + i;
+  g[dst] = scan[i]; beta[dst] = bv;
+}
+
+// Invert I + tril(beta_i <k_i,k_j> exp(G_i-G_j), -1). The solve is
+// FP32; its BF16 result is the WY representation used by the block scan.
+__global__ void inverse_kernel(const uint16_t* keys, const float* g,
+                               const float* beta, uint16_t* inverse,
+                               int hk, int hv) {
+  const int c = blockIdx.x, h = blockIdx.y;
+  const int64_t ch = int64_t(c) * hv + h;
+  const uint16_t* k = keys + (int64_t(c) * hk + h / (hv / hk)) * B * D;
+  __shared__ float a[B * B], inv[B * B];
+  for (int z = threadIdx.x; z < B * B; z += blockDim.x) {
+    const int i = z / B, j = z % B;
+    float value = 0.f;
+    if (j < i) {
+      const float bi = beta[ch * B + i];
+      for (int d = 0; d < D; ++d) {
+        // The reference's promoted beta*K operand enters a TF32 MMA.
+        // Its low 13 mantissa bits are discarded before multiplication.
+        const float scaled = __uint_as_float(__float_as_uint(f(k[i * D + d]) * bi) & 0xffffe000u);
+        value = fmaf(scaled, f(k[j * D + d]), value);
+      }
+      value *= ex(g[ch * B + i] - g[ch * B + j]);
+    }
+    a[z] = value;
+    inv[z] = i == j ? 1.f : 0.f;
+  }
+  __syncthreads();
+  for (int i = 1; i < B; ++i) {
+    const int j = threadIdx.x;
+    if (j < i) {
+      float value = -a[i * B + j];
+      for (int p = j + 1; p < i; ++p)
+        value = fmaf(-a[i * B + p], inv[p * B + j], value);
+      inv[i * B + j] = value;
+    }
+    __syncthreads();
+  }
+  for (int z = threadIdx.x; z < B * B; z += blockDim.x)
+    inverse[ch * B * B + z] = b(inv[z]);
+}
+
+__global__ void wy_kernel(const uint16_t* x, const uint16_t* keys,
+                          const float* g, const float* beta,
+                          const uint16_t* inverse, uint16_t* w, uint16_t* u,
+                          int tokens, int hk, int hv) {
+  const int c = blockIdx.x, h = blockIdx.y;
+  const int64_t ch = int64_t(c) * hv + h;
+  const uint16_t* k = keys + (int64_t(c) * hk + h / (hv / hk)) * B * D;
+  __shared__ uint16_t ai[B * B], kb[B * D], vb[B * D];
+  for (int z = threadIdx.x; z < B * B; z += blockDim.x)
+    ai[z] = inverse[ch * B * B + z];
+  for (int z = threadIdx.x; z < B * D; z += blockDim.x) {
+    const int i = z / D, d = z % D, t = c * B + i;
+    const float bi = beta[ch * B + i];
+    kb[z] = b((f(k[z]) * bi) * ex(g[ch * B + i]));
+    vb[z] = t < tokens ? b(f(x[(int64_t(t) * (2 * hk + hv) + 2 * hk + h) * D + d]) * bi) : 0;
+  }
+  __syncthreads();
+  for (int z = threadIdx.x; z < B * D; z += blockDim.x) {
+    const int i = z / D, d = z % D;
+    float sw = 0.f, su = 0.f;
+    for (int p = 0; p <= i; ++p) {
+      const float v = f(ai[i * B + p]);
+      sw = fmaf(v, f(kb[p * D + d]), sw);
+      su = fmaf(v, f(vb[p * D + d]), su);
+    }
+    w[ch * B * D + z] = b(sw); u[ch * B * D + z] = b(su);
+  }
+}
+
+// Each value slice owns its state for every block in this prefill call.
+// The persistent state is never rounded; BF16 views feed the matrix products.
+__global__ void state_kernel(const uint16_t* keys, const float* g,
+                             const uint16_t* w, const uint16_t* u,
+                             uint16_t* vn, uint16_t* history, float* state,
+                             int tokens, int chunks, int hk, int hv) {
+  const int h = blockIdx.x, v0 = blockIdx.y * VS;
+  __shared__ float s[VS * D];
+  __shared__ uint16_t weighted[B * VS];
+  for (int z = threadIdx.x; z < VS * D; z += blockDim.x)
+    s[z] = state[(int64_t(h) * D + v0) * D + z];
+  __syncthreads();
+  for (int c = 0; c < chunks; ++c) {
+    const int64_t ch = int64_t(c) * hv + h;
+    const uint16_t* k = keys + (int64_t(c) * hk + h / (hv / hk)) * B * D;
+    const int live = min(B, tokens - c * B);
+    const float last = g[ch * B + live - 1];
+    for (int z = threadIdx.x; z < VS * D; z += blockDim.x)
+      history[(ch * D + v0) * D + z] = b(s[z]);
+    __syncthreads();
+    for (int z = threadIdx.x; z < B * VS; z += blockDim.x) {
+      const int i = z / VS, v = z % VS;
+      float lo = 0.f, hi = 0.f;
+      for (int d = 0; d < 64; ++d) {
+        lo = fmaf(f(w[(ch * B + i) * D + d]), f(b(s[v * D + d])), lo);
+        hi = fmaf(f(w[(ch * B + i) * D + 64 + d]), f(b(s[v * D + 64 + d])), hi);
+      }
+      const float delta = f(u[(ch * B + i) * D + v0 + v]) - (lo + hi);
+      vn[(ch * B + i) * D + v0 + v] = b(delta);
+      weighted[z] = i < live ? b(delta * ex(last - g[ch * B + i])) : 0;
+    }
+    __syncthreads();
+    for (int z = threadIdx.x; z < VS * D; z += blockDim.x) {
+      const int v = z / D, d = z % D;
+      float delta = 0.f;
+      for (int i = 0; i < live; ++i)
+        delta = fmaf(f(k[i * D + d]), f(weighted[i * VS + v]), delta);
+      s[z] = __fadd_rn(__fmul_rn(s[z], ex(last)), delta);
+    }
+    __syncthreads();
+  }
+  for (int z = threadIdx.x; z < VS * D; z += blockDim.x)
+    state[(int64_t(h) * D + v0) * D + z] = s[z];
+}
+
+__global__ void output_kernel(const uint16_t* queries, const uint16_t* keys,
+                              const float* g, const uint16_t* vn,
+                              const uint16_t* history, uint16_t* out,
+                              int tokens, int hk, int hv, float scale) {
+  const int c = blockIdx.x, h = blockIdx.y, v0 = blockIdx.z * VS;
+  const int64_t ch = int64_t(c) * hv + h;
+  const int64_t kh = int64_t(c) * hk + h / (hv / hk);
+  const uint16_t* k = keys + kh * B * D;
+  __shared__ uint16_t q[B * D], a[B * B], st[VS * D], v[B * VS];
+  for (int z = threadIdx.x; z < B * D; z += blockDim.x) q[z] = queries[kh * B * D + z];
+  for (int z = threadIdx.x; z < VS * D; z += blockDim.x) st[z] = history[(ch * D + v0) * D + z];
+  for (int z = threadIdx.x; z < B * VS; z += blockDim.x)
+    v[z] = vn[(ch * B + z / VS) * D + v0 + z % VS];
+  __syncthreads();
+  for (int z = threadIdx.x; z < B * B; z += blockDim.x) {
+    const int i = z / B, j = z % B;
+    float value = 0.f;
+    if (j <= i) {
+      for (int d = 0; d < D; ++d) value = fmaf(f(q[i * D + d]), f(k[j * D + d]), value);
+      value *= ex(g[ch * B + i] - g[ch * B + j]);
+    }
+    a[z] = b(value);
+  }
+  __syncthreads();
+  for (int z = threadIdx.x; z < B * VS; z += blockDim.x) {
+    const int i = z / VS, vi = z % VS, t = c * B + i;
+    if (t >= tokens) continue;
+    float before = 0.f, within = 0.f;
+    for (int d = 0; d < D; ++d) before = fmaf(f(q[i * D + d]), f(st[vi * D + d]), before);
+    for (int j = 0; j <= i; ++j) within = fmaf(f(a[i * B + j]), f(v[j * VS + vi]), within);
+    out[(int64_t(t) * hv + h) * D + v0 + vi] = b((before * ex(g[ch * B + i])) * scale + within * scale);
+  }
+}
+}  // namespace
+
+size_t gdn_chunk_workspace_bytes(int tokens, int hk, int hv) {
+  if (tokens < 0 || hk <= 0 || hv <= 0 || hv % hk)
+    throw std::invalid_argument("gdn chunk: invalid geometry");
+  const size_t chunks = (size_t(tokens) + B - 1) / B;
+  return chunks * (size_t(2) * hk * B * D * 2 +
+                   size_t(hv) * (B * B * 2 + 3 * B * D * 2 + D * D * 2 + 2 * B * 4));
+}
+
+void gdn_chunk_fwd(const uint16_t* qkv, const uint16_t* a, int64_t as,
+                   const uint16_t* beta, int64_t bs, const float* al,
+                   const float* dt, float* state, uint16_t* out,
+                   int tokens, int hk, int hv, float scale,
+                   void* workspace, size_t workspace_bytes, cudaStream_t stream) {
+  if (tokens <= 0) return;
+  const size_t needed = gdn_chunk_workspace_bytes(tokens, hk, hv);
+  if (!qkv || !a || !beta || !al || !dt || !state || !out || !workspace ||
+      workspace_bytes < needed || as < hv || bs < hv)
+    throw std::invalid_argument("gdn chunk: invalid storage");
+  const int chunks = (tokens + B - 1) / B;
+  const auto s = buffers(workspace, chunks, hk, hv);
+  prepare_qk<<<dim3(chunks * B, hk), D, 0, stream>>>(qkv, s.q, s.k, tokens, hk, hv);
+  prepare_gates<<<dim3(chunks, hv), B, 0, stream>>>(a, as, beta, bs, al, dt, s.g, s.beta, tokens, hv);
+  inverse_kernel<<<dim3(chunks, hv), 256, 0, stream>>>(s.k, s.g, s.beta, s.inverse, hk, hv);
+  wy_kernel<<<dim3(chunks, hv), 256, 0, stream>>>(qkv, s.k, s.g, s.beta, s.inverse, s.w, s.u, tokens, hk, hv);
+  state_kernel<<<dim3(hv, D / VS), 256, 0, stream>>>(s.k, s.g, s.w, s.u, s.vn, s.h, state, tokens, chunks, hk, hv);
+  output_kernel<<<dim3(chunks, hv, D / VS), 256, 0, stream>>>(s.q, s.k, s.g, s.vn, s.h, out, tokens, hk, hv, scale);
+  DGPP_CUDA_OK(cudaGetLastError());
+}
+}  // namespace dgpp
