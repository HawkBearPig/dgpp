{
  "model": "nvidia/Qwen3.8-Flash-Next-NVFP4",
  "world_size": 2,
  "engine": {
    "max_concurrency": 2,
    "kv_capacity": 532480,
    "kv_dtype": "bf16",
    "ngram_table": "mmap",
    "rope_scaling": {
      "rope_type": "yarn",
      "factor": 2.0,
      "original_max_position_embeddings": 262144,
      "beta_fast": 32,
      "beta_slow": 1,
      "attn_factor": 1.0,
      "mrope_cache_factor": 4.0
