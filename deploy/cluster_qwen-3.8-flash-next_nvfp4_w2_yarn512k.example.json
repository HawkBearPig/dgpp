    "default_max_tokens": 256,
    "queue_limit": 8,
    "max_connections": 64,
    "decode_graph": true,
    "mtp": true,
    "mtp_depth": 1,
    "prefix_cache_gib": 1.5,
    "admission": "full",
    "admission_window": 256,
    "sampling_candidates": 128,
    "stats_interval_s": 10,
    "dense_weights": "fp8",
    "fp8_head": "mma",
    "bf16_weights": "bf12+bf16"
  },
  "nvme_cache": {
    "enabled": false,
    "path": "~/dgpp/nvme-cache",
    "capacity_gib": 64
  },
  "paths": {
    "resident_cache": ""
  }
}
