{
  "version": 6,
  "configurePresets": [
    {
      "name": "spark-cross",
      "inherits": "release",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/spark-cross.cmake"
    },
    {
      "name": "base",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DGPP_WERROR": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "description": "Production server: full optimization, no debug symbols",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -g0",
        "CMAKE_CUDA_FLAGS_RELEASE": "-O3 -DNDEBUG -Xcompiler=-g0",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-s",
        "DGPP_SANITIZE": ""
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "asan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "DGPP_SANITIZE": "address"
      }
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "DGPP_SANITIZE": "undefined"
      }
    },
    {
      "name": "ci",
      "inherits": "base",
      "description": "Testing: optimized host code with debug symbols and warnings as errors",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "DGPP_WERROR": "ON"}
    }
  ],
  "buildPresets": [
    {"name": "spark-cross", "configurePreset": "spark-cross", "targets": ["dgpp_serve_app"]},
    {"name": "release", "configurePreset": "release", "targets": ["dgpp_serve_app"]},
    {"name": "debug", "configurePreset": "debug"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "ubsan", "configurePreset": "ubsan"},
    {"name": "ci", "configurePreset": "ci"}
  ],
  "testPresets": [
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "ci", "configurePreset": "ci", "output": {"outputOnFailure": true}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}},
    {"name": "ubsan", "configurePreset": "ubsan", "output": {"outputOnFailure": true}}
  ]
}
